{
  "name": "twitter-url-replacer",
  "version": "1.1.2",
  "description": "I will replace the domain of the URL copied from the Twitter share button.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/webextension-polyfill": "^0.10.7",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  },
  "keywords": [
    "chrome-extension",
    "twitter",
    "x",
    "url-replacer",
    "fixupx",
    "fxtwitter"
  ],
  "author": "minagishl",
  "license": "MIT"
}
